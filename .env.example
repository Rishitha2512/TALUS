# Local: http://127.0.0.1:8000
# Docker: http://backend:8000
# Cloud: https://<your-backend-domain>
TALUS_API_URL=http://127.0.0.1:8000
TALUS_CORS_ORIGINS=*
TALUS_DB_PATH=database/talus.db
# Set TALUS_DATABASE_URL to use PostgreSQL; it takes precedence over SQLite.
# TALUS_DATABASE_URL=postgresql://talus:password@localhost:5432/talus
TALUS_AUTH_ENABLED=false
# Required when TALUS_AUTH_ENABLED=true. Use a randomly generated secret (32+ characters).
TALUS_AUTH_SECRET=
TALUS_ADMIN_USERNAME=admin
TALUS_ADMIN_PASSWORD=
